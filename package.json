{
  "name": "motion-aware-rppg-demo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "prisma": {
    "seed": "tsx server/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "vite",
    "build": "npm run build:api && tsc -b && vite build",
    "build:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=api/index.js",
    "db:seed": "tsx server/seed.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "batch": "tsx scripts/batch.ts",
    "publish-results": "tsx scripts/publish-results.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
