// MotionPulse admin backend — one database (Prisma Postgres).
// Scan rows store numbers, short traces, and an optional tiny thumb.
// FeedPost may store a short face clip when someone posts it to the public feed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL") — uncomment if prisma migrate needs the non-pooled host
}

model Account {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  passwordHash String
  role         String          @default("subject") // admin | subject
  status       String          @default("active") // active | disabled
  createdAt    DateTime        @default(now())
  profile      SubjectProfile?
  authSessions AuthSession[]
  scanSessions ScanSession[]
}

model SubjectProfile {
  id               String    @id @default(cuid())
  accountId        String    @unique
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ageBand          String?
  note             String?
  consentMetricsAt DateTime?
  consentVideo     Boolean   @default(false)
  consentVideoAt   DateTime?
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([accountId])
}

model Content {
  key       String   @id
  text      String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model ScanSession {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  source          String // sample | upload | webcam | local-lab
  nickname        String?
  pipelineVersion String?
  userId          String?
  user            Account?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips           Clip[]

  @@index([createdAt])
  @@index([userId])
}

model Clip {
  id               String        @id @default(cuid())
  sessionId        String
  session          ScanSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  index            Int           @default(0)
  durationSec      Float?
  fps              Float?
  width            Int?
  height           Int?
  settledHeartRate Float?
  rawBpm           Float?
  respiratoryRate  Float? // experimental
  signalLabel      String?
  risk             String?
  /// Motion–pulse conflict at save time. Null on clips saved before this field.
  conflictScore    Float?
  regionWeights    Float[] // forehead, left cheek, right cheek, lower face
  waveform         Float[] // short downsampled pulse trace
  thumb            String? // optional tiny data-url crop, never raw video
  groundTruth      GroundTruth?

  @@index([sessionId])
}

// Public feed posts. A short face clip is stored only when someone shares it.
model FeedPost {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  nickname        String?
  bpm             Float
  conflictScore   Float
  riskLevel       String
  respiratoryRate Float?
  durationSec     Float
  source          String
  thumb           String?
  videoMime       String?
  videoBytes      Bytes?
  hasVideo        Boolean  @default(false)
  /// Dataset subject this card came from. Null on older webcam posts.
  labSubjectId    String?  @unique
  datasetName     String?
  referenceBpm    Float?
  /// CHROM or POS. Null on posts from before the method was stored.
  method          String?
  /// Hidden posts stay in the database and drop off the public feed.
  hidden          Boolean  @default(false)
  /// The post can stay public while the face video stays off the feed.
  videoHidden     Boolean  @default(false)
  userId          String?
  /// Motion, spectrum, and trust summaries. Null on older posts.
  detail          Json?

  @@index([createdAt])
}

// One Start on a dataset. Numbers only — the videos stay on disk.
model LabTest {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  name      String
  clipCount Int          @default(0)
  faceCount Int          @default(0)
  paired    Int          @default(0)
  mae       Float?
  rmse      Float?
  pearson   Float?
  snrMean   Float?
  snrDb     Float?
  bias      Float?
  loaLow    Float?
  loaHigh   Float?
  subjects  LabSubject[]

  @@index([createdAt])
}

model LabSubject {
  id              String   @id @default(cuid())
  testId          String
  test            LabTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  subject         String
  bpm             Float
  /// Equal-weight heart rate before motion suppression.
  plainBpm        Float?
  /// Heart rate after trust-weighting the four face regions.
  weightedBpm     Float?
  /// Mean heart rate of windows below the elevated conflict band.
  cleanedBpm      Float?
  referenceBpm    Float?
  snr             Float?
  durationSec     Float
  respiratoryRate Float?
  breathsInClip   Float?
  risk            String
  conflict        Float
  windows         Int
  frames          Int
  /// CHROM or POS. Older rows were CHROM.
  method          String   @default("CHROM")
  /// Face still from the clip. Same size cap as a feed thumb. The video stays on disk.
  thumb           String?
  /// Motion, spectrum, and trust. Same shape as a feed card, without a video.
  detail          Json

  @@index([testId])
}

// One PhysNet training finish. Numbers and names only — the videos stay on disk.
model TrainRun {
  id          String        @id @default(cuid())
  startedAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  name        String
  method      String        @default("PhysNet")
  folder      String
  epochs      Int
  people      Int
  windowCount Int           @default(0)
  finalLoss   Float?
  bestLoss    Float?
  /// Mean absolute miss, in BPM, on people held out of this run.
  heldMae     Float?
  heldCount   Int           @default(0)
  /// Dataset the checkpoint was tested on after training, when one was chosen.
  crossName   String        @default("")
  crossMae    Float?
  crossCount  Int           @default(0)
  checkpoint  String        @default("")
  status      String
  note        String        @default("")
  history     Json
  peopleRows  TrainPerson[]

  @@index([startedAt])
}

model TrainPerson {
  id      String   @id @default(cuid())
  runId   String
  run     TrainRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  subject       String
  role          String
  windows       Int    @default(0)
  bpm           Float?
  referenceBpm  Float?

  @@index([runId])
}

model GroundTruth {
  id               String  @id @default(cuid())
  clipId           String  @unique
  clip             Clip    @relation(fields: [clipId], references: [id], onDelete: Cascade)
  heartRate        Float
  source           String // self-count | dataset | device
  datasetName      String?
  datasetSubjectId String?
}
