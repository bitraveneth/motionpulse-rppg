# Supabase (optional). When unset, the UI uses a localStorage mock feed.
# Create a project at https://supabase.com, then run supabase/schema.sql
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional aliases for CLI publish-results (falls back to VITE_* above)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Local lab UI (batch datasets). Always on in `npm run dev`.
# Only set true on a deploy if you intentionally want the Local lab nav —
# do NOT encourage casual visitors to download multi‑GB datasets.
# VITE_ENABLE_LOCAL_LAB=true
